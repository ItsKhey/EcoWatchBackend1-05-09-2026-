PORT=5000

# Legacy MongoDB connection — migration scripts only

MONGODB_MIGRATION_URI=your_mongodb_migration_uri

# Supabase PostgreSQL — production database

SUPABASE_DATABASE_URL=your_supabase_database_url

# Authentication

JWT_SECRET=your_jwt_secret

# Email

RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=EcoWatch [onboarding@resend.dev](mailto:onboarding@resend.dev)

# Cloudinary

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Cloud Messaging (Render environment variables)
# Prefer one complete JSON value, or use the three split variables below.
# The same credential also backs email verification and password reset.
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"your-project","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase email verification + password reset
#
# Continue URL for the emailed links. This is an HTTPS App Link on the Firebase
# default domain so Android can verify it against the app's signing certificate
# and open EcoWatch directly, with no browser chooser.
#
# Two things must both be true for that to work:
#   1. a page must be deployed at this path (see firebase-hosting/ in the app), and
#   2. the app's signing certificate SHA-256 must be registered in the Firebase
#      console. Without it Android falls back to a chooser, which still works.
#
# Both links use the same URL. Firebase tells them apart with mode=verifyEmail
# versus mode=resetPassword, and the app routes on it.
#
# Fallback that needs neither a hosting site nor a registered SHA: point this at
# a custom scheme that the app also declares, and add the scheme to Firebase's
# authorized domains.
#   FIREBASE_CONTINUE_URL=ecowatch://password-reset
FIREBASE_CONTINUE_URL=https://ecowatch1-4445f.firebaseapp.com/finishSignUp
FIREBASE_VERIFICATION_CONTINUE_URL=https://ecowatch1-4445f.firebaseapp.com/finishSignUp

# Android package the Firebase action page hands off to.
# FIREBASE_ANDROID_PACKAGE_NAME=com.example.myecowatch1

# Google Maps / Admin

EcowatchAdminKey1=your_google_maps_api_key

NODE_ENV=development
