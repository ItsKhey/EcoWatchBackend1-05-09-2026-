PORT=5000

# Bind address for the local server. 0.0.0.0 accepts connections from other
# machines on the network, which is what a real phone needs. The Android
# emulator reaches the same server through 10.0.2.2.
HOST=0.0.0.0

# Legacy MongoDB connection — migration scripts only

MONGODB_MIGRATION_URI=your_mongodb_migration_uri

# Database
#
# DATABASE_URL is the local PostgreSQL server and is the active target.
# config/db.js falls back to SUPABASE_DATABASE_URL only when DATABASE_URL is
# absent, so pointing the project at a local server is a one line change.
#
# The same schema runs on both, so either can be used at any time. SSL is
# negotiated for remote hosts only, because a local server has no certificate.

DATABASE_URL=postgresql://postgres:your_local_password@localhost:5432/ecowatch
SUPABASE_DATABASE_URL=your_supabase_database_url

# Override the automatic SSL decision. Unset means "TLS for remote, none for
# local", which is right in both cases.
# DATABASE_SSL=false

# Image storage
#
# local      writes into ./uploads, served by this server at /uploads
# cloudinary uploads to the Cloudinary CDN
#
# Delete fails safe either way, and a row left over from the hosted setup still
# resolves against Cloudinary when this is set to local.

IMAGE_STORAGE_PROVIDER=local

# Whether a new resident account must verify its email address.
#
# false  create the account immediately: no OTP, no Resend email, no Firebase.
# true   stage a pending registration and email a 4-digit code through Resend.
#
# A client can override this per request with verificationMethod, so an app built
# for either transport works whichever value is set here.
REGISTRATION_REQUIRES_VERIFICATION=false

# Authentication

JWT_SECRET=your_jwt_secret

# Mail provider — LEGACY OTP FLOW ONLY
#
# The Resident app needs none of this. Firebase sends its own verification and
# reset emails from the device through the client SDK, so the Firebase flow has no
# outbound mail credential at all.
#
# These are still required by the Admin app, which continues to use the original
# 4-digit OTP. Delete this section, the resend dependency, and
# services/emailServices.js once the Admin app moves to the Firebase flow.

RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=EcoWatch <onboarding@resend.dev>

# Cloudinary
#
# Only read when IMAGE_STORAGE_PROVIDER=cloudinary. A local run needs none of
# these, which is the point of writing photos to ./uploads instead.

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Cloud Messaging (Render environment variables)
# Prefer one complete JSON value, or use the three split variables below.
# The same credential also backs email verification and password reset.
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"your-project","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase email verification + password reset
#
# Continue URL for the emailed links. This is an HTTPS App Link on the Firebase
# default domain so Android can verify it against the app's signing certificate
# and open EcoWatch directly, with no browser chooser.
#
# Two things must both be true for that to work:
#   1. a page must be deployed at this path (see firebase-hosting/ in the app), and
#   2. the app's signing certificate SHA-256 must be registered in the Firebase
#      console. Without it Android falls back to a chooser, which still works.
#
# Both links use the same URL. Firebase tells them apart with mode=verifyEmail
# versus mode=resetPassword, and the app routes on it.
#
# Fallback that needs neither a hosting site nor a registered SHA: point this at
# a custom scheme that the app also declares, and add the scheme to Firebase's
# authorized domains.
#   FIREBASE_CONTINUE_URL=ecowatch://password-reset
FIREBASE_CONTINUE_URL=https://ecowatch1-4445f.firebaseapp.com/finishSignUp
FIREBASE_VERIFICATION_CONTINUE_URL=https://ecowatch1-4445f.firebaseapp.com/finishSignUp

# Android package the Firebase action page hands off to.
# FIREBASE_ANDROID_PACKAGE_NAME=com.example.myecowatch1

# Google Maps / Admin

EcowatchAdminKey1=your_google_maps_api_key

# Retention job for reporter accounts an administrator disabled.
# Every day at 4:00 AM the job permanently deletes those accounts once they have
# been disabled for more than 30 days. Accounts a resident paused themselves are
# never touched: that pause is reversible and they may return at any time.
#
# Unlike the report and announcement cleanups, this one is irreversible, so it
# has an off switch. Set this to true to stop the job from starting at all, for
# example while a deployment is being inspected.
# RESIDENT_PURGE_DISABLED=false

NODE_ENV=development
