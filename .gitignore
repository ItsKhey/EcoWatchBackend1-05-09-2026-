# Environment variables and secrets
.env
.env.*
!.env.example

# Node.js dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE/editor files
.vscode/
.idea/
*.iml

# Local databases
*.db
*.sqlite
*.sqlite3

# Uploaded report and profile photos written by the local image storage
# provider. Runtime content, not source: the folder is created on boot and
# images are rebuilt by the app that uploaded them.
uploads/*
!uploads/.gitkeep

# Database dumps created while moving a database between machines
*.dump
*.backup

# Credentials and certificates
secrets/
credentials/
*.pem
*.key
*.crt

# Temporary files
tmp/
temp/
*.tmp

# Test/coverage/build output
coverage/
dist/
build/
out/